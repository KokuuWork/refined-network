{
  "schemaVersion": 1,
  "id": "rswirelesscrafting",
  "version": "${version}",
  "name": "Refined Network",
  "description": "An addon for Refined Storage 2. Wireless terminals, upgrade cards and block devices that work at any distance and across dimensions; the farther you are, the more each action costs.",
  "icon": "assets/rswirelesscrafting/icon.png",
  "authors": [
    "Kokuu"
  ],
  "contact": {
    "sources": "https://github.com/KokuuWork/refined-network",
    "issues": "https://github.com/KokuuWork/refined-network/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kokuu.rswirelesscrafting.fabric.ModInitializerImpl"
    ],
    "client": [
      "com.kokuu.rswirelesscrafting.fabric.ClientModInitializerImpl"
    ],
    "refinedstorage_plugin": [
      "com.kokuu.rswirelesscrafting.fabric.ModInitializerImpl"
    ]
  },
  "mixins": [
    "rswirelesscrafting.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.6",
    "fabric-api": ">=0.101.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "refinedstorage": ">=2.0.7",
    "cloth-config2": "*",
    "team_reborn_energy": "*"
  }
}
