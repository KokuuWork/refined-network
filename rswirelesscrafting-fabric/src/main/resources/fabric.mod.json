{
  "schemaVersion": 1,
  "id": "rswirelesscrafting",
  "version": "${version}",
  "name": "Refined Storage - Wireless Crafting",
  "description": "Adds wireless crafting and pattern terminals, upgrade cards, charging, wireless links, energy monitoring, smart sorting and network bridging for Refined Storage.",
  "authors": [
    "Kokuu"
  ],
  "contact": {
    "sources": "https://github.com/KokuuWork/rswirelesscrafting",
    "issues": "https://github.com/KokuuWork/rswirelesscrafting/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kokuu.rswirelesscrafting.fabric.ModInitializerImpl"
    ],
    "client": [
      "com.kokuu.rswirelesscrafting.fabric.ClientModInitializerImpl"
    ],
    "refinedstorage_plugin": [
      "com.kokuu.rswirelesscrafting.fabric.ModInitializerImpl"
    ]
  },
  "mixins": [
    "rswirelesscrafting.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.6",
    "fabric-api": ">=0.101.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "refinedstorage": ">=2.0.7",
    "cloth-config2": "*",
    "team_reborn_energy": "*"
  }
}
